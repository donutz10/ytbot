# Required: from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=paste-your-bot-token-here

# Optional: register commands to one server only (instant). Leave empty for global.
GUILD_ID=

# Optional: path to a Netscape-format cookies.txt if YouTube says "Sign in to confirm you're not a bot"
YTDLP_COOKIES=

# Optional overrides (Docker sets these for you)
YTDLP_PATH=yt-dlp
FFMPEG_PATH=

# Optional: PO-token provider for YouTube on cloud IPs (docker-compose sets this for you)
POT_PROVIDER_URL=
